Options -Indexes -MultiViews
RewriteEngine On
RewriteBase /

# Bloquer l'accès direct au FS Bucket (/data/) ; la réécriture interne ci-dessous reste autorisée
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^data(/|$) - [F,NC]

# Exports JSON : servis depuis le FS Bucket (/data) s'ils y sont présents, sinon repli sur la racine
RewriteCond %{DOCUMENT_ROOT}/data/$1.json -f
RewriteRule ^(export_formation|export_session|organism)\.json$ data/$1.json [L]

# Redirect CGV vers le PDF
RewriteRule ^cgv/?$ /Documents/CGV%20Formation%20MAR22.pdf [R=301,L]

# Supprimer le slash final (sauf racine) pour URLs canoniques
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# SPA routing : rediriger vers index.html sauf fichiers/dossiers existants et assets
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(js|css|json|php|png|jpg|jpeg|gif|svg|pdf|ico|woff|woff2|ttf|eot|map)$ [NC]
RewriteRule ^ index.html [L]

# Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Cache statique
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/json "access plus 1 day"
</IfModule>

# Pas de cache navigateur pour les JSON (mis à jour chaque nuit)
<IfModule mod_headers.c>
    <FilesMatch "\.json$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# CORS pour send-email.php
<FilesMatch "send-email\.php$">
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "POST"
    Header set Access-Control-Allow-Headers "Content-Type"
</FilesMatch>
